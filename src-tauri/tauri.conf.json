{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tiny Kanban",
  "version": "0.3.0",
  "identifier": "app.tinykanban",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tiny Kanban",
        "width": 720,
        "height": 440,
        "minWidth": 140,
        "minHeight": 70,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false,
        "transparent": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "deb",
      "rpm",
      "nsis",
      "msi",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2M0Q2QTg0MUI3QTMwRjIKUldUeU1Ib2JoR285cHJqMHlFa3ZBM0tGY29mNW1XWUxaMWhmNGVmQmlONzBDWEg2YjNQdFlaaysK",
      "endpoints": [
        "https://github.com/datorkar/tiny-kanban/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
